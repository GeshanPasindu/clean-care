# Copy to .env and replace placeholders. Never commit .env.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/clean-care

# Generate a private random value of at least 32 characters.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Exact browser origin(s), comma separated.
FRONTEND_ORIGINS=http://localhost:3000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Optional email sender configuration used by staff email notifications.
USER_EMAIL=your-sender@example.com
USER_PASS=your-email-app-password
